FROM node:lts-alpine as build-stage
ARG MODE
WORKDIR /app
COPY package*.json ./
RUN npm i
COPY . .
RUN npm run build -- --mode ${MODE} --dest dist-docker

FROM nginx:stable-alpine as run-stage
COPY --from=build-stage /app/dist-docker /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]